# Reference values only. Do not commit real values in this file.
# The public frontend values are configured in config.js.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only: set through Supabase's function secrets if not automatically available.
# NEVER put this value in config.js or any browser-accessible file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used as the publicBaseUrl in config.js after GitHub Pages deployment.
ARCADE_PUBLIC_BASE_URL=https://YOUR_GITHUB_USERNAME.github.io/gdgoc-arcade/
